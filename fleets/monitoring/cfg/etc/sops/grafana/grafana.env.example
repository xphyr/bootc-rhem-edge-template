# EXAMPLE ONLY - placeholder values, never put real secrets in this file.
# To use: copy to the name below (drop ".example", keep ".sops."), fill in the
# real values, then encrypt in place BEFORE committing:
#   cp <this file> <real name> && $EDITOR <real name> && sops --encrypt --in-place <real name>
# Real name: grafana.sops.env
# Admin password for the built-in admin user.
GF_SECURITY_ADMIN_PASSWORD=replace-with-admin-password
# Only needed if you enable [auth.generic_oauth] in grafana.ini.
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=replace-with-oidc-client-secret
