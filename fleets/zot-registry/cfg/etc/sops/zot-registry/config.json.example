{
  "distSpecVersion": "1.1.0",
  "storage": {
    "rootDirectory": "/var/lib/zot",
    "dedupe": true,
    "gc": true,
    "remoteCache": true,
    "storageDriver": {
      "name": "s3",
      "rootdirectory": "/zot",
      "region": "us-east-1",
      "regionendpoint": "https://s3.example.com",
      "bucket": "zot-registry",
      "accesskey": "replace-with-s3-access-key",
      "secretkey": "replace-with-s3-secret-key",
      "forcepathstyle": true,
      "secure": true,
      "skipverify": false,
      "chunksize": "104857600",
      "multipartcopychunksize": "268435456",
      "multipartcopymaxconcurrency": "8",
      "multipartcopythresholdsize": "268435456"
    },
    "cacheDriver": {
      "name": "redis",
      "url": "redis://localhost:6379/0",
      "keyprefix": "zot"
    }
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "readTimeout": "1h",
    "writeTimeout": "1h",
    "compat": ["docker2s2"],
    "auth": {
      "htpasswd": { "path": "/etc/zot/htpasswd.bin" },
      "apikey": true
    },
    "accessControl": {
      "repositories": {
        "**": {
          "anonymousPolicy": ["read"],
          "defaultPolicy": ["read"]
        }
      },
      "adminPolicy": {
        "users": ["admin"],
        "actions": ["read", "create", "update", "delete"]
      }
    }
  },
  "log": { "level": "info" },
  "extensions": {
    "search": { "enable": true },
    "ui": { "enable": true },
    "sync": {
      "enable": true,
      "downloadDir": "/var/lib/zot/sync",
      "registries": [
        {
          "urls": ["https://registry-1.docker.io"],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 3,
          "retryDelay": "5m",
          "content": [{ "prefix": "**", "destination": "/docker.io" }]
        }
      ]
    }
  }
}
